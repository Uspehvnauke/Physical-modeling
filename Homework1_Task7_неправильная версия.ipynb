        "test_a = 0.5\n",
        "test_seed = 42\n",
        "n_runs = 10  # Количество запусков для усреднения времени\n",
        "\n",
        "print(f\"\\nПараметры тестирования:\")\n",
        "print(f\"  Энергия: {test_energy} МэВ\")\n",
        "print(f\"  Источник: {test_origin}\")\n",
        "print(f\"  Параметр a: {test_a}\")\n",
        "print(f\"  Количество запусков: {n_runs}\")\n",
        "print(f\"  Ожидаемое число фотонов: {int(test_energy * 10000)}\")\n",
        "\n",
        "# Тестирование итеративной версии\n",
        "print(\"\\n\" + \"-\" * 70)\n",
        "print(\"ТЕСТ 1: Итеративная версия (цикл по фотонам)\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "times_iterative = []\n",
        "for i in range(n_runs):\n",
        "    start_time = time.time()\n",
        "    result_iter = simulate_event_iterative(\n",
        "        detector, source, test_energy, test_origin, test_a, test_seed + i\n",
        "    )\n",
        "    end_time = time.time()\n",
        "    times_iterative.append(end_time - start_time)\n",
        "\n",
        "avg_time_iterative = np.mean(times_iterative)\n",
        "std_time_iterative = np.std(times_iterative)\n",
        "\n",
        "print(f\"\\nРезультаты итеративной версии:\")\n",
        "print(f\"  Среднее время: {avg_time_iterative:.4f} ± {std_time_iterative:.4f} с\")\n",
        "print(f\"  Число фотонов: {result_iter['n_photons']}\")\n",
        "print(f\"  Детектировано фотонов: {result_iter['detected_photons']}\")\n",
        "print(f\"  Всего фотоэлектронов: {result_iter['total_photoelectrons']}\")\n",
        "\n",
        "# Тестирование векторизованной версии\n",
        "print(\"\\n\" + \"-\" * 70)\n",
        "print(\"ТЕСТ 2: Векторизованная версия (numpy операции)\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "times_vectorized = []\n",
        "for i in range(n_runs):\n",
        "    start_time = time.time()\n",
        "    result_vec = simulate_event_vectorized(\n",
        "        detector, source, test_energy, test_origin, test_a, test_seed + i\n",
        "    )\n",
        "    end_time = time.time()\n",
        "    times_vectorized.append(end_time - start_time)\n",
        "\n",
        "avg_time_vectorized = np.mean(times_vectorized)\n",
        "std_time_vectorized = np.std(times_vectorized)\n",
        "\n",
        "print(f\"\\nРезультаты векторизованной версии:\")\n",
        "print(f\"  Среднее время: {avg_time_vectorized:.4f} ± {std_time_vectorized:.4f} с\")\n",
        "print(f\"  Число фотонов: {result_vec['n_photons']}\")\n",
        "print(f\"  Детектировано фотонов: {result_vec['detected_photons']}\")\n",
        "print(f\"  Всего фотоэлектронов: {result_vec['total_photoelectrons']}\")\n",
        "\n",
        "# Сравнение результатов\n",
        "print(\"\\n\" + \"-\" * 70)\n",
        "print(\"СРАВНЕНИЕ РЕЗУЛЬТАТОВ\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "print(f\"\\nПроверка корректности:\")\n",
        "print(f\"  Число фотонов совпадает: {result_iter['n_photons'] == result_vec['n_photons']}\")\n",
        "print(f\"  Детектировано фотонов совпадает: {result_iter['detected_photons'] == result_vec['detected_photons']}\")\n",
        "print(f\"  Распределение по ФЭУ совпадает: {np.array_equal(result_iter['pmt_counts'], result_vec['pmt_counts'])}\")\n",
        "\n",
        "# Вычисление ускорения\n",
        "speedup = avg_time_iterative / avg_time_vectorized\n",
        "time_saving = (1 - avg_time_vectorized / avg_time_iterative) * 100\n",
        "\n",
        "print(f\"\\nАнализ производительности:\")\n",
        "print(f\"  Итеративная версия:    {avg_time_iterative:.4f} с\")\n",
        "print(f\"  Векторизованная версия: {avg_time_vectorized:.4f} с\")\n",
        "print(f\"  Ускорение:              {speedup:.2f}x\")\n",
        "print(f\"  Экономия времени:       {time_saving:.1f}%\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"ВЫВОД\")\n",
