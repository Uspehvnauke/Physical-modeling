        "# ЗАДАЧА 7. ВЕКТОРИЗАЦИЯ ВЫЧИСЛЕНИЙ\n",
        "\n",
        "**Цель задачи:** реализовать полностью векторизованную версию симуляции события с использованием numpy.array вместо итерации по отдельным фотонам, и оценить выигрыш во времени выполнения.\n",
        "\n",
        "**Требования:**\n",
        "1. Использовать numpy.array для хранения информации о всех фотонах в событии\n",
        "2. Модифицировать методы для генерации, пропагации фотонов и вычисления числа фотоэлектронов так, чтобы они работали с массивами фотонов\n",
        "3. Оценить выигрыш во времени от использования numpy по сравнению с итерацией по отдельным фотонам\n",
        "\n",
        "**Подход:**\n",
        "- Создать векторизованную версию функции `simulate_event`, которая обрабатывает все фотоны одновременно через numpy операции\n",
        "- Векторизовать вычисление пересечений со сферой для всех направлений сразу\n",
        "- Векторизовать определение попаданий на ФЭУ\n",
        "- Векторизовать генерацию фотоэлектронов\n",
        "- Сравнить время выполнения с оригинальной итеративной версией"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ==================== ЗАДАЧА 7: ВЕКТОРИЗАЦИЯ ВЫЧИСЛЕНИЙ ====================\n",
        "import numpy as np\n",
        "import time\n",
        "from typing import Optional\n",
        "\n",
        "def intersect_sphere_vectorized(\n",
        "    origins: np.ndarray,\n",
        "    directions: np.ndarray,\n",
        "    radius: float,\n",
        ") -> tuple[np.ndarray, np.ndarray]:\n",
        "    \"\"\"Векторизованное вычисление первого пересечения луча со сферой.\n",
        "    \n",
        "    Parameters\n",
        "    ----------\n",
        "    origins : ndarray, shape (N, 3)\n",
        "        Точки рождения фотонов.\n",
        "    directions : ndarray, shape (N, 3)\n",
        "        Направления движения фотонов (нормированные).\n",
        "    radius : float\n",
        "        Радиус сферы.\n",
        "    \n",
        "    Returns\n",
        "    -------\n",
        "    distances : ndarray, shape (N,)\n",
        "        Пути от origin до границы для каждого фотона.\n",
        "    hit_points : ndarray, shape (N, 3)\n",
        "        Координаты точек пересечения.\n",
        "    \"\"\"\n",
        "    # Вычисляем скалярное произведение origin · direction для каждого фотона\n",
        "    projections = np.sum(origins * directions, axis=1)\n",
        "    \n",
        "    # Вычисляем |origin|^2 для каждого фотона\n",
        "    origin_norms_sq = np.sum(origins ** 2, axis=1)\n",
        "    \n",
        "    # Дискриминант для каждого фотона\n",
        "    discriminants = projections ** 2 + radius ** 2 - origin_norms_sq\n",
        "    \n",
        "    # Расстояние до пересечения для каждого фотона\n",
        "    distances = -projections + np.sqrt(np.maximum(discriminants, 0.0))\n",
        "    \n",
        "    # Точки пересечения\n",
        "    hit_points = origins + distances[:, np.newaxis] * directions\n",
        "    \n",
        "    return distances, hit_points\n",
        "\n",
        "\n",
        "def find_pmt_at_hit_vectorized(\n",
        "    detector: 'Detector',\n",
        "    hit_points: np.ndarray,\n",
        ") -> np.ndarray:\n",
        "    \"\"\"Векторизованное определение индексов ФЭУ для точек попадания.\n",
        "    \n",
        "    Parameters\n",
        "    ----------\n",
        "    detector : Detector\n",
        "        Объект детектора.\n",
        "    hit_points : ndarray, shape (N, 3)\n",
        "        Точки попадания на сферу.\n",
        "    \n",
        "    Returns\n",
        "    -------\n",
        "    pmt_indices : ndarray, shape (N,)\n",
        "        Индексы ФЭУ для каждого фотона (-1 если не попал).\n",
        "    \"\"\"\n",
        "    # Нормируем точки попадания (они уже на сфере радиуса R)\n",
        "    hit_directions = hit_points / detector.R\n",
        "    \n",
        "    # Вычисляем косинусы углов между направлениями попаданий и осями ФЭУ\n",
        "    # hit_directions: (N, 3), pmt_directions: (M, 3)\n",
        "    # Результат: (N, M)\n",
        "    cos_angles = hit_directions @ detector.pmt_directions.T\n",
        "    \n",
        "    # Порог по косинусу угла\n",
        "    threshold = np.cos(detector.theta_pmt)\n",
        "    \n",
        "    # Находим индекс ФЭУ с максимальным косинусом для каждого фотона\n",
        "    best_pmt_indices = np.argmax(cos_angles, axis=1)\n",
        "    best_cos_angles = cos_angles[np.arange(len(hit_points)), best_pmt_indices]\n",
        "    \n",
        "    # Если косинус меньше порога, фотон не попал ни на один ФЭУ\n",
        "    pmt_indices = np.where(best_cos_angles >= threshold, best_pmt_indices, -1)\n",
        "    \n",
        "    return pmt_indices\n",
        "\n",
        "\n",
        "def generate_photoelectrons_vectorized(\n",
        "    n_photons_detected: int,\n",
        "    mean_photoelectrons: float,\n",
        "    rng: np.random.Generator,\n",
        ") -> int:\n",
        "    \"\"\"Векторизованная генерация числа фотоэлектронов.\n",
        "    \n",
        "    Parameters\n",
        "    ----------\n",
        "    n_photons_detected : int\n",
        "        Число фотонов, попавших на фотокатоды.\n",
        "    mean_photoelectrons : float\n",
        "        Среднее число фотоэлектронов на один фотон (параметр a).\n",
        "    rng : np.random.Generator\n",
        "        Генератор случайных чисел.\n",
        "    \n",
        "    Returns\n",
        "    -------\n",
        "    total_photoelectrons : int\n",
        "        Общее число фотоэлектронов.\n",
        "    \"\"\"\n",
        "    # Сумма независимых пуассоновских величин также имеет распределение Пуассона\n",
        "    # с параметром, равным сумме параметров\n",
        "    if n_photons_detected > 0:\n",
        "        total_photoelectrons = rng.poisson(mean_photoelectrons * n_photons_detected)\n",
        "    else:\n",
        "        total_photoelectrons = 0\n",
        "    \n",
        "    return int(total_photoelectrons)\n",
        "\n",
        "\n",
        "def simulate_event_vectorized(\n",
        "    detector: 'Detector',\n",
        "    source: 'Source',\n",
        "    energy_mev: float,\n",
        "    origin=(0.0, 0.0, 0.0),\n",
        "    a: float = 0.5,\n",
        "    seed: int = 2026,\n",
        ") -> dict:\n",
        "    \"\"\"Полностью векторизованная симуляция одного события.\n",
        "    \n",
        "    Все фотоны обрабатываются одновременно через numpy операции.\n",
        "    \n",
        "    Parameters\n",
        "    ----------\n",
        "    detector : Detector\n",
        "        Объект детектора.\n",
        "    source : Source\n",
        "        Объект источника.\n",
        "    energy_mev : float\n",
        "        Энергия события в МэВ.\n",
        "    origin : tuple\n",
        "        Координаты источника.\n",
        "    a : float\n",
        "        Среднее число фотоэлектронов на один попавший фотон.\n",
        "    seed : int\n",
        "        Seed для генератора случайных чисел.\n",
        "    \n",
        "    Returns\n",
        "    -------\n",
        "    result : dict\n",
        "        Словарь с результатами симуляции.\n",
        "    \"\"\"\n",
        "    origin = np.asarray(origin, dtype=float)\n",
        "    rng = np.random.default_rng(seed)\n",
        "    \n",
        "    # Генерируем все направления сразу\n",
        "    directions = source.generate_directions(energy_mev, rng=rng)\n",
        "    n_photons = len(directions)\n",
        "    \n",
        "    # Создаем массив точек рождения для всех фотонов\n",
        "    origins = np.tile(origin, (n_photons, 1))\n",
        "    \n",
        "    # Векторизованное вычисление пересечений со сферой\n",
        "    distances, hit_points = intersect_sphere_vectorized(\n",
        "        origins, directions, detector.R\n",
        "    )\n",
        "    \n",
        "    # Векторизованное определение попаданий на ФЭУ\n",
        "    pmt_indices = find_pmt_at_hit_vectorized(detector, hit_points)\n",
        "    \n",
        "    # Подсчитываем число фотонов, попавших на каждый ФЭУ\n",
        "    pmt_counts = np.zeros(detector.N, dtype=int)\n",
        "    for pmt_id in range(detector.N):\n",
        "        mask = pmt_indices == pmt_id\n",
        "        pmt_counts[pmt_id] = np.sum(mask)\n",
        "    \n",
        "    # Векторизованная генерация фотоэлектронов для каждого ФЭУ\n",
        "    photoelectrons_per_pmt = rng.poisson(a * pmt_counts)\n",
        "    total_photoelectrons = int(np.sum(photoelectrons_per_pmt))\n",
        "    \n",
        "    # Число детектированных фотонов\n",
        "    detected_photons = int(np.sum(pmt_indices >= 0))\n",
        "    \n",
        "    return {\n",
        "        \"origin\": origin,\n",
        "        \"directions\": directions,\n",
        "        \"hit_points\": hit_points,\n",
        "        \"path_lengths\": distances,\n",
        "        \"pmt_indices\": pmt_indices,\n",
        "        \"pmt_counts\": pmt_counts,\n",
        "        \"photoelectrons_per_pmt\": photoelectrons_per_pmt,\n",
        "        \"total_photoelectrons\": total_photoelectrons,\n",
        "        \"detected_photons\": detected_photons,\n",
        "        \"n_photons\": n_photons,\n",
        "    }\n",
        "\n",
        "\n",
        "def simulate_event_iterative(\n",
        "    detector: 'Detector',\n",
        "    source: 'Source',\n",
        "    energy_mev: float,\n",
        "    origin=(0.0, 0.0, 0.0),\n",
        "    a: float = 0.5,\n",
        "    seed: int = 2026,\n",
        ") -> dict:\n",
        "    \"\"\"Итеративная симуляция одного события (для сравнения).\n",
        "    \n",
        "    Фотоны обрабатываются по одному в цикле.\n",
        "    \n",
        "    Parameters\n",
        "    ----------\n",
        "    detector : Detector\n",
        "        Объект детектора.\n",
        "    source : Source\n",
        "        Объект источника.\n",
        "    energy_mev : float\n",
        "        Энергия события в МэВ.\n",
        "    origin : tuple\n",
        "        Координаты источника.\n",
        "    a : float\n",
        "        Среднее число фотоэлектронов на один попавший фотон.\n",
        "    seed : int\n",
        "        Seed для генератора случайных чисел.\n",
        "    \n",
        "    Returns\n",
        "    -------\n",
        "    result : dict\n",
        "        Словарь с результатами симуляции.\n",
        "    \"\"\"\n",
        "    origin = np.asarray(origin, dtype=float)\n",
        "    rng = np.random.default_rng(seed)\n",
        "    \n",
        "    # Генерируем все направления\n",
        "    directions = source.generate_directions(energy_mev, rng=rng)\n",
        "    n_photons = len(directions)\n",
        "    \n",
        "    hit_points = np.empty((n_photons, 3), dtype=float)\n",
        "    path_lengths = np.empty(n_photons, dtype=float)\n",
        "    pmt_indices = np.full(n_photons, -1, dtype=int)\n",
        "    pmt_counts = np.zeros(detector.N, dtype=int)\n",
        "    \n",
        "    # Итеративная обработка каждого фотона\n",
        "    for i in range(n_photons):\n",
        "        direction = directions[i]\n",
        "        \n",
        "        # Вычисление пересечения со сферой\n",
        "        projection = np.dot(origin, direction)\n",
        "        discriminant = projection**2 + detector.R**2 - np.dot(origin, origin)\n",
        "        distance = -projection + np.sqrt(max(discriminant, 0.0))\n",
        "        hit_point = origin + distance * direction\n",
        "        \n",
        "        path_lengths[i] = distance\n",
        "        hit_points[i] = hit_point\n",
        "        \n",
        "        # Определение ФЭУ\n",
        "        hit_direction = hit_point / np.linalg.norm(hit_point)\n",
        "        cos_angles = detector.pmt_directions @ hit_direction\n",
        "        threshold = np.cos(detector.theta_pmt)\n",
        "        pmt_id = np.argmax(cos_angles)\n",
        "        \n",
        "        if cos_angles[pmt_id] >= threshold:\n",
        "            pmt_indices[i] = pmt_id\n",
        "            pmt_counts[pmt_id] += 1\n",
        "    \n",
        "    # Генерация фотоэлектронов для каждого ФЭУ\n",
        "    photoelectrons_per_pmt = np.zeros(detector.N, dtype=int)\n",
        "    for pmt_id in range(detector.N):\n",
        "        if pmt_counts[pmt_id] > 0:\n",
        "            photoelectrons_per_pmt[pmt_id] = rng.poisson(a * pmt_counts[pmt_id])\n",
        "    \n",
        "    total_photoelectrons = int(np.sum(photoelectrons_per_pmt))\n",
        "    detected_photons = int(np.sum(pmt_indices >= 0))\n",
        "    \n",
        "    return {\n",
        "        \"origin\": origin,\n",
        "        \"directions\": directions,\n",
        "        \"hit_points\": hit_points,\n",
        "        \"path_lengths\": path_lengths,\n",
        "        \"pmt_indices\": pmt_indices,\n",
        "        \"pmt_counts\": pmt_counts,\n",
        "        \"photoelectrons_per_pmt\": photoelectrons_per_pmt,\n",
        "        \"total_photoelectrons\": total_photoelectrons,\n",
        "        \"detected_photons\": detected_photons,\n",
        "        \"n_photons\": n_photons,\n",
        "    }\n",
        "\n",
        "\n",
        "# ==================== СРАВНЕНИЕ ПРОИЗВОДИТЕЛЬНОСТИ ====================\n",
        "print(\"=\" * 70)\n",
        print(\"ЗАДАЧА 7: ВЕКТОРИЗАЦИЯ ВЫЧИСЛЕНИЙ\")\n",
        print(\"=\" * 70)\n",
        "\n",
        "# Параметры для тестирования\n",
        "test_energy = 1.0  # МэВ\n",
