        "- find_pmt_at_hit_vectorized: определение ФЭУ для всех точек попадания\n",
        "- generate_photoelectrons_vectorized: генерация фотоэлектронов для всех ФЭУ\n",
        "- simulate_event_vectorized: полная векторизованная симуляция события\n",
        "\"\"\")"
      ]
    }
